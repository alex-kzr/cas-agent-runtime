{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "scenario_id": {
      "type": "string"
    },
    "scenario_version": {
      "type": "string"
    },
    "outcome": {
      "enum": [
        "pending",
        "pass",
        "fail",
        "error",
        "blocked",
        "skipped"
      ]
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "expected": {},
          "observed": {},
          "outcome": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "expected",
          "observed",
          "outcome",
          "evidence_refs"
        ],
        "additionalProperties": true
      }
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "scenario_id",
    "scenario_version",
    "outcome",
    "prerequisites",
    "checks"
  ],
  "additionalProperties": true,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cas.invalid/contracts/v1/assertions.schema.json"
}
