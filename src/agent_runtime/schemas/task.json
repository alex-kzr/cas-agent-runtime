{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "task_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "kind": {
      "enum": [
        "task",
        "scenario"
      ]
    },
    "scenario_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "instructions": {
      "type": "string",
      "minLength": 1
    },
    "agent": {
      "type": "object"
    },
    "workspace": {
      "type": "string"
    },
    "limits": {
      "type": "object",
      "properties": {
        "max_turns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "max_budget_usd": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        }
      },
      "required": [
        "max_turns",
        "max_budget_usd",
        "timeout_seconds"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "kind",
    "scenario_id",
    "instructions",
    "agent",
    "workspace",
    "limits"
  ],
  "additionalProperties": true,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "task"
          }
        }
      },
      "then": {
        "properties": {
          "task_id": {
            "type": "string",
            "format": "uuid"
          },
          "scenario_id": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "task_id": {
            "type": "null"
          },
          "scenario_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ],
  "$id": "https://cas.invalid/contracts/v1/task.schema.json"
}
