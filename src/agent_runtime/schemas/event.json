{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "enum": [
        "application",
        "sdk",
        "hook",
        "permission",
        "mcp",
        "validator"
      ]
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "parent_event_seq": {
      "type": [
        "integer",
        "null"
      ]
    },
    "correlation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "payload": {
      "type": "object"
    },
    "redaction": {
      "type": "object",
      "properties": {
        "applied": {
          "type": "boolean"
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "applied",
        "fields"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "seq",
    "timestamp",
    "source",
    "type",
    "session_id",
    "parent_event_seq",
    "correlation_id",
    "payload",
    "redaction"
  ],
  "additionalProperties": true,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cas.invalid/contracts/v1/event.schema.json"
}
