{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artifact_id": {
            "type": "string",
            "format": "uuid"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\\\:]).+$"
          },
          "media_type": {
            "type": "string"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "producer": {
            "type": "string"
          },
          "sensitivity": {
            "enum": [
              "normal",
              "sensitive"
            ]
          }
        },
        "required": [
          "artifact_id",
          "path",
          "media_type",
          "size_bytes",
          "sha256",
          "producer",
          "sensitivity"
        ],
        "additionalProperties": true
      }
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "artifacts"
  ],
  "additionalProperties": true,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cas.invalid/contracts/v1/artifacts.schema.json"
}
