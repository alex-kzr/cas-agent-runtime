{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "kind": {
      "enum": [
        "task",
        "scenario"
      ]
    },
    "task_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "scenario_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "CREATED",
        "VALIDATING",
        "RUNNING",
        "COMPLETED",
        "FAILED",
        "CANCELLED",
        "INTERRUPTED"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "started_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "ended_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "provider": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "sdk_package": {
          "type": [
            "string",
            "null"
          ]
        },
        "sdk_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "cli_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "requested_model": {
          "type": [
            "string",
            "null"
          ]
        },
        "resolved_model": {
          "type": [
            "string",
            "null"
          ]
        },
        "os": {
          "type": [
            "string",
            "null"
          ]
        },
        "python": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "sdk_package",
        "sdk_version",
        "cli_version",
        "requested_model",
        "resolved_model",
        "os",
        "python"
      ],
      "additionalProperties": true
    },
    "instructions_ref": {
      "type": "string"
    },
    "configuration": {
      "type": "object"
    },
    "workspace": {
      "type": "string"
    },
    "limits": {
      "type": "object",
      "properties": {
        "max_turns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "max_budget_usd": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        }
      },
      "required": [
        "max_turns",
        "max_budget_usd",
        "timeout_seconds"
      ],
      "additionalProperties": true
    },
    "session_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "resumes_run_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "retry_of_run_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "validation": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "pending",
            "passed",
            "failed",
            "error"
          ]
        },
        "validator_version": {
          "type": "string"
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "required": [
        "status",
        "validator_version",
        "checks"
      ],
      "additionalProperties": true
    },
    "sdk_outcome": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "subtype": {
              "type": [
                "string",
                "null"
              ]
            },
            "is_error": {
              "type": "boolean"
            },
            "terminal_reason": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "subtype",
            "is_error",
            "terminal_reason"
          ],
          "additionalProperties": true
        },
        {
          "type": "null"
        }
      ]
    },
    "result_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "artifacts_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "error": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "category": {
              "type": "string"
            },
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "retryable": {
              "type": "boolean"
            },
            "evidence_refs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "category",
            "code",
            "message",
            "retryable",
            "evidence_refs"
          ],
          "additionalProperties": true
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence_status": {
      "enum": [
        "complete",
        "partial",
        "unavailable"
      ]
    },
    "usage": {
      "type": "object",
      "properties": {
        "sdk": {
          "type": [
            "object",
            "null"
          ]
        },
        "application": {
          "type": [
            "object",
            "null"
          ]
        }
      },
      "required": [
        "sdk",
        "application"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "kind",
    "task_id",
    "scenario_id",
    "status",
    "created_at",
    "updated_at",
    "started_at",
    "ended_at",
    "provider",
    "instructions_ref",
    "configuration",
    "workspace",
    "limits",
    "session_id",
    "resumes_run_id",
    "retry_of_run_id",
    "validation",
    "sdk_outcome",
    "result_ref",
    "artifacts_ref",
    "error",
    "evidence_status",
    "usage"
  ],
  "additionalProperties": true,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "task"
          }
        }
      },
      "then": {
        "properties": {
          "task_id": {
            "type": "string",
            "format": "uuid"
          },
          "scenario_id": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "task_id": {
            "type": "null"
          },
          "scenario_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ],
  "$id": "https://cas.invalid/contracts/v1/run.schema.json"
}
